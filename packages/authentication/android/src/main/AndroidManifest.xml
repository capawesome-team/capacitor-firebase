<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Without this, the check for a browser to run the generic IDP flow in is filtered out by
         package visibility on Android 11 and up, and reports that none exists on every device. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
